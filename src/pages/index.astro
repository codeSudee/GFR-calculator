---
import Layout from '../layouts/Layout.astro';
import CalculatorIsland from '../components/CalculatorIsland.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';

const faqs: { q: string; a: string; link?: { href: string; text: string } }[] = [
	{
		q: "How to calculate GFR formula?",
		a: "Every GFR formula on this site takes the same core inputs — serum creatinine, age, and sex — and plugs them into a fixed equation. For CKD-EPI 2021, you first divide your creatinine by a sex-specific constant (kappa), raise the min and max of that ratio to fixed exponents, multiply by 142, then apply an age-decay term (0.9938 raised to your age) and a small multiplier if female. Cockcroft-Gault instead multiplies (140 minus age) by weight in kg, divides by 72 times serum creatinine, and applies a 0.85 multiplier if female. Enter your values above and the calculator shows every step of whichever formula you choose.",
	},
	{
		q: "What should my eGFR be for my age?",
		a: "A normal eGFR for adults is usually above 90, and it falls gradually with age. National Kidney Foundation averages run from 116 at ages 20 to 29, to 99 at ages 40 to 49, 85 at ages 60 to 69, and 75 at age 70 and over. An eGFR below 60 for more than three months meets the definition of chronic kidney disease at any age.",
		link: { href: "/normal-gfr-by-age", text: "See the normal GFR by age chart" },
	},
	{
		q: "Will drinking more water raise your GFR?",
		a: "Only if you are dehydrated. Rehydrating can bring a temporarily low reading back up, but extra water beyond that has not been shown to help: in the CKD WIT randomized trial, coaching adults with CKD to drink more did not slow their decline in kidney function. Too much fluid can be harmful with advanced kidney disease or heart problems, so ask your doctor how much is right for you.",
		link: { href: "/how-to-improve-gfr", text: "How to improve GFR" },
	},
	{
		q: "What is the most accurate GFR calculator?",
		a: "A calculator is only as accurate as the equation it uses and how correctly it implements it. CKD-EPI 2021 is the equation recommended by the NKF and ASN for adults in the US, and adding cystatin C can improve precision when creatinine is unreliable. Implementation matters too: a 2020 study found 8 of 47 free online GFR calculators had faults, including mishandled race coefficients and unit conversions.",
		link: { href: "/methodology", text: "Read our methodology" },
	},
	{
		q: "Which GFR formula should I use?",
		a: "For general kidney-function screening, use CKD-EPI 2021. For drug dosing, many references use Cockcroft-Gault, which estimates creatinine clearance from weight. For children, use the bedside Schwartz equation. Use CKD-EPI 2009 or MDRD only when you need to match an older lab report.",
	},
	{
		q: "How does a GFR calculator with weight work?",
		a: "A GFR calculator with weight uses the Cockcroft-Gault equation, which estimates creatinine clearance in mL/min from body weight rather than scaling to a standard 1.73m² body size as CKD-EPI and MDRD do. It multiplies (140 minus age) by weight in kilograms, divides by 72 times serum creatinine in mg/dL, and applies a 0.85 multiplier for female patients.",
		link: { href: "/creatinine-clearance-calculator", text: "Creatinine clearance calculator" },
	},
	{
		q: "Can I use this calculator for a child?",
		a: "No. CKD-EPI, MDRD, and Cockcroft-Gault were developed in adults, so this calculator requires an age of 18 or older. For children, use our pediatric GFR calculator, which applies the bedside Schwartz equation to height and serum creatinine.",
		link: { href: "/pediatric-gfr-calculator", text: "Pediatric GFR calculator" },
	},
	{
		q: "Can I enter creatinine in µmol/L?",
		a: "Yes. You can enter creatinine in mg/dL, common in the US, or µmol/L, common elsewhere. The calculator converts automatically using the standard factor of 1 mg/dL = 88.4 µmol/L before running any formula.",
		link: { href: "/creatinine-converter", text: "Creatinine converter" },
	},
];

const title = 'GFR Calculator: Check Your eGFR and CKD Stage for Free';
const description =
	'Enter your creatinine, age, and sex to get your eGFR and CKD stage in seconds. Uses CKD-EPI 2021, shows the math, and keeps your numbers in your browser.';
---

<Layout
	modified="2026-11-03"
	schema={[
		{
			'@type': 'WebApplication',
			name: 'GFR Calculator',
			url: 'https://gfrcalc.com/',
			description,
			applicationCategory: 'HealthApplication',
			operatingSystem: 'Any (web browser)',
			offers: {
				'@type': 'Offer',
				price: '0',
				priceCurrency: 'USD',
			},
		},
		{
			'@type': 'FAQPage',
				mainEntity: faqs.map((f) => ({
					'@type': 'Question',
					name: f.q,
					acceptedAnswer: { '@type': 'Answer', text: f.a },
				})),
		},
	]}
	title={title}
	description={description}
>
	<section class="container-page pt-14 pb-8 sm:pt-20">
		<div class="mx-auto max-w-2xl text-center">
			<h1 class="text-[2.25rem] font-semibold leading-[1.1] tracking-tight text-ink sm:text-5xl sm:tracking-tighter">
				GFR Calculator
			</h1>
			<p class="mt-4 text-base leading-relaxed text-body sm:text-lg">
				Enter your creatinine, age, and sex to get your eGFR and CKD stage. Uses the CKD-EPI 2021
				equation by default and shows every step of the math.
			</p>
			<nav aria-label="Site pages" class="mt-6">
				<ul class="flex flex-col items-center gap-3 text-lg">
					<li><a href="/about" class="text-body hover:text-ink">About Us</a></li>
					<li><a href="/contact" class="text-body hover:text-ink">Contact Us</a></li>
					<li><a href="/privacy-policy" class="text-body hover:text-ink">Privacy Policy</a></li>
					<li><a href="/terms" class="text-body hover:text-ink">Terms &amp; Conditions</a></li>
				</ul>
			</nav>
		</div>
	</section>

	<section class="container-page pb-16">
		<div class="mx-auto max-w-2xl">
			<CalculatorIsland />
			<div class="mt-6">
				<MedicalDisclaimer />
			</div>
		</div>
	</section>

	<section class="border-t border-hairline bg-canvas-elevated py-16">
		<div class="container-page">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
					Built to be verifiably accurate
				</h2>
				<p class="mt-3 text-base leading-relaxed text-body">
					A peer-reviewed 2020 study tested 47 freely available online GFR calculators and found
					that 8 of them (17%) were faulty, from errors such as mishandled race coefficients and
					unit conversions.
				</p>
			</div>

			<div class="mx-auto mt-10 grid max-w-3xl gap-6 sm:grid-cols-3">
				<div class="rounded-md border border-hairline p-5">
					<div class="flex h-9 w-9 items-center justify-center rounded-full bg-link-soft text-link-deep">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="M9 12l2 2 4-4M12 3l7 4v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V7l7-4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/>
						</svg>
					</div>
					<h3 class="mt-3 text-sm font-semibold text-ink">Tested unit conversion</h3>
					<p class="mt-1.5 text-sm leading-relaxed text-body">
						mg/dL &harr; &micro;mol/L conversion is centralized in one function and covered by
						automated tests in both directions.
					</p>
				</div>
				<div class="rounded-md border border-hairline p-5">
					<div class="flex h-9 w-9 items-center justify-center rounded-full bg-link-soft text-link-deep">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="M4 6h16M4 12h10M4 18h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
						</svg>
					</div>
					<h3 class="mt-3 text-sm font-semibold text-ink">Full step-by-step math</h3>
					<p class="mt-1.5 text-sm leading-relaxed text-body">
						Every result shows the formula with your actual numbers substituted in, so you can
						verify the calculation yourself.
					</p>
				</div>
				<div class="rounded-md border border-hairline p-5">
					<div class="flex h-9 w-9 items-center justify-center rounded-full bg-link-soft text-link-deep">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="M12 21s-7-4.5-9-9.5C1.5 7 4 3.5 8 4.5c1.7.4 3 1.7 4 3 1-1.3 2.3-2.6 4-3 4-1 6.5 2.5 5 7-2 5-9 9.5-9 9.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
						</svg>
					</div>
					<h3 class="mt-3 text-sm font-semibold text-ink">Race-free by default</h3>
					<p class="mt-1.5 text-sm leading-relaxed text-body">
						Follows the 2021 NKF/ASN recommendation to remove race from eGFR estimation across
						every formula on this site.
					</p>
				</div>
			</div>

			<div class="mt-8 text-center">
				<a href="/methodology" class="text-sm font-medium text-link hover:text-link-deep">
					Read our full methodology &rarr;
				</a>
			</div>
		</div>
	</section>

	<section class="border-t border-hairline py-16">
		<div class="container-page">
			<div class="guide mx-auto max-w-2xl">
				<h2 class="!mt-0 !text-2xl sm:!text-3xl">What your eGFR result means</h2>
				<p>
					eGFR estimates how much blood your kidneys filter each minute. Higher is better, and a
					normal adult result is usually above 90. Results from CKD-EPI and MDRD map onto the KDIGO
					stages below.
				</p>
				<div class="table-wrap">
					<table>
						<caption class="sr-only">CKD stages by eGFR, in mL/min/1.73m²</caption>
						<thead>
							<tr><th scope="col">eGFR</th><th scope="col">Stage</th><th scope="col">Kidney function</th></tr>
						</thead>
						<tbody>
							<tr><th scope="row">90 or above</th><td>G1</td><td>Normal or high</td></tr>
							<tr><th scope="row">60&ndash;89</th><td>G2</td><td>Mildly decreased</td></tr>
							<tr><th scope="row">45&ndash;59</th><td>G3a</td><td>Mildly to moderately decreased</td></tr>
							<tr><th scope="row">30&ndash;44</th><td>G3b</td><td>Moderately to severely decreased</td></tr>
							<tr><th scope="row">15&ndash;29</th><td>G4</td><td>Severely decreased</td></tr>
							<tr><th scope="row">Below 15</th><td>G5</td><td>Kidney failure</td></tr>
						</tbody>
					</table>
				</div>
				<p>
					One low result is not a CKD diagnosis. KDIGO requires reduced eGFR or another marker of
					kidney damage, such as albumin in the urine, to last more than three months. If your
					result is unexpectedly low, or you have diabetes, high blood pressure, or a family history
					of kidney disease, ask a clinician about a repeat test.
					<a href="/egfr-results">See what your eGFR number means</a>.
				</p>

				<h2>Which formula should you choose?</h2>
				<div class="table-wrap">
					<table>
						<caption class="sr-only">Equations available on this site and when each is used</caption>
						<thead>
							<tr><th scope="col">Equation</th><th scope="col">Best for</th><th scope="col">Inputs</th></tr>
						</thead>
						<tbody>
							<tr><th scope="row"><a href="/ckd-epi-calculator">CKD-EPI 2021</a></th><td>General use in adults; the current US standard</td><td>Creatinine, age, sex</td></tr>
							<tr><th scope="row"><a href="/creatinine-clearance-calculator">Cockcroft-Gault</a></th><td>Drug dosing references</td><td>Creatinine, age, sex, weight</td></tr>
							<tr><th scope="row"><a href="/cystatin-c-gfr-calculator">Cystatin C</a></th><td>When creatinine may mislead, such as low muscle mass</td><td>Cystatin C, age, sex</td></tr>
							<tr><th scope="row"><a href="/pediatric-gfr-calculator">Bedside Schwartz</a></th><td>Children</td><td>Creatinine, height</td></tr>
							<tr><th scope="row">CKD-EPI 2009, MDRD</th><td>Matching older lab reports</td><td>Creatinine, age, sex</td></tr>
						</tbody>
					</table>
				</div>
				<p>
					Your numbers stay in your browser. They are never sent to a server, and no sign-up is
					required.
				</p>
			</div>
		</div>
	</section>


	<section class="border-t border-hairline py-16">
		<div class="container-page">
			<div class="mx-auto max-w-2xl">
				<h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
					Understand your result
				</h2>
				<ul class="mt-6 grid gap-3 sm:grid-cols-2">
					<li class="rounded-md border border-hairline p-4">
						<a href="/egfr-results" class="text-sm font-medium text-link hover:text-link-deep">What your eGFR number means</a>
						<p class="mt-1 text-sm text-body">eGFR 90, 70, 60, 55, 45, 30, and 15 explained.</p>
					</li>
					<li class="rounded-md border border-hairline p-4">
						<a href="/ckd-stages" class="text-sm font-medium text-link hover:text-link-deep">CKD stages chart</a>
						<p class="mt-1 text-sm text-body">eGFR ranges for stages 1 to 5, plus albuminuria.</p>
					</li>
					<li class="rounded-md border border-hairline p-4">
						<a href="/normal-gfr-by-age" class="text-sm font-medium text-link hover:text-link-deep">Normal GFR by age</a>
						<p class="mt-1 text-sm text-body">Average values from age 20 to 70+.</p>
					</li>
					<li class="rounded-md border border-hairline p-4">
						<a href="/how-to-improve-gfr" class="text-sm font-medium text-link hover:text-link-deep">How to improve GFR</a>
						<p class="mt-1 text-sm text-body">What can raise eGFR and what protects it.</p>
					</li>
					<li class="rounded-md border border-hairline p-4">
						<a href="/egfr-blood-test" class="text-sm font-medium text-link hover:text-link-deep">eGFR blood test</a>
						<p class="mt-1 text-sm text-body">What the test measures and what affects it.</p>
					</li>
					<li class="rounded-md border border-hairline p-4">
						<a href="/egfr-vs-creatinine-clearance" class="text-sm font-medium text-link hover:text-link-deep">eGFR vs creatinine clearance</a>
						<p class="mt-1 text-sm text-body">Why the two numbers differ and when each is used.</p>
					</li>
				</ul>
			</div>
		</div>
	</section>

	<section class="border-t border-hairline bg-canvas-elevated py-16">
		<div class="container-page">
			<div class="mx-auto max-w-2xl">
				<h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
					Frequently asked questions
				</h2>

				<div class="mt-8 divide-y divide-hairline border-y border-hairline">
					{
						faqs.map((f) => (
							<details class="group py-5">
								<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-ink">
									{f.q}
									<svg class="h-4 w-4 shrink-0 text-mute transition-transform group-open:rotate-45" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
										<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
									</svg>
								</summary>
								<p class="mt-3 text-sm leading-relaxed text-body">
									{f.a}
									{f.link && (
										<>
											{' '}
											<a href={f.link.href} class="text-link hover:text-link-deep">
												{f.link.text}
											</a>
											.
										</>
									)}
								</p>
							</details>
						))
					}
				</div>
			</div>
		</div>
	</section>
</Layout>
