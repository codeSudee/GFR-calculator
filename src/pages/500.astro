---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Server Error — GFR Calculator"
	description="Something went wrong on our end. Please try again or return to the GFR Calculator homepage."
	noindex
>
	<section class="container-page py-20 sm:py-28">
		<div class="mx-auto max-w-xl text-center">
			<p class="font-mono text-xs font-medium uppercase tracking-wide text-mute">Error 500</p>
			<h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">Something went wrong</h1>
			<p class="mt-4 text-base leading-relaxed text-body">
				An unexpected error occurred on our end. It's not you — please try again in a moment.
			</p>

			<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
				<a
					href="/"
					class="rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-canvas transition-colors hover:opacity-90"
				>
					Go to the GFR Calculator
				</a>
				<a
					href="/contact"
					class="rounded-full border border-hairline px-5 py-2.5 text-sm font-medium text-body transition-colors hover:text-ink"
				>
					Contact us
				</a>
			</div>

			<p class="mt-10 text-sm text-faint">
				If this keeps happening, please let us know on the
				<a href="/contact" class="text-link hover:text-link-deep">Contact Us</a> page so we can look into it.
			</p>
		</div>
	</section>
</Layout>
