---
import Layout from '../layouts/Layout.astro';

const contactEmail = 'contact@gfrcalc.com';
---

<Layout
	title="Contact Us — GFR Calculator"
	description="Get in touch with the GFR Calculator team with questions, corrections, or feedback about our eGFR and kidney function calculator."
>
	<article class="container-page py-14 sm:py-20">
		<div class="mx-auto max-w-2xl">
			<p class="font-mono text-xs font-medium uppercase tracking-wide text-mute">Contact Us</p>
			<h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">Contact Us</h1>

			<p class="mt-6 text-base leading-relaxed text-body">
				Have a question, found an error in a calculation, or have feedback on the calculator?
				We'd like to hear from you.
			</p>

			<div class="mt-8 rounded-md border border-hairline p-6">
				<h2 class="text-base font-semibold text-ink">Email us</h2>
				<p class="mt-2 text-sm leading-relaxed text-body">
					For all inquiries, including formula corrections, bug reports, and general feedback:
				</p>
				<a
					href={`mailto:${contactEmail}`}
					class="mt-3 inline-flex items-center gap-2 text-base font-medium text-link hover:text-link-deep"
				>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M4 6h16v12H4V6Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
						<path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" />
					</svg>
					{contactEmail}
				</a>
			</div>

			<h2 class="mt-10 text-xl font-semibold tracking-tight text-ink">Reporting a calculation error</h2>
			<p class="mt-4 text-base leading-relaxed text-body">
				Accuracy is the reason this site exists — see our
				<a href="/methodology" class="text-link hover:text-link-deep">methodology</a> page for
				background. If you believe a result is incorrect, please include the formula used
				(CKD-EPI 2021, CKD-EPI 2009, MDRD, or Cockcroft-Gault), your input values, and the result
				you expected, so we can investigate quickly.
			</p>

			<h2 class="mt-10 text-xl font-semibold tracking-tight text-ink">Medical questions</h2>
			<p class="mt-4 text-base leading-relaxed text-body">
				We can't provide medical advice or interpret your personal results. For questions about
				your kidney function or health, please contact a qualified healthcare professional.
			</p>
		</div>
	</article>
</Layout>
