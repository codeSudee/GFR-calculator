---
interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section
	role="note"
	aria-label="Medical disclaimer"
	class:list={[
		'rounded-md border border-hairline bg-hairline-soft',
		compact ? 'p-4' : 'p-5 sm:p-6',
	]}
>
	<div class="flex gap-3">
		<svg
			class="mt-0.5 h-5 w-5 flex-shrink-0 text-warning-deep"
			viewBox="0 0 24 24"
			fill="none"
			aria-hidden="true"
		>
			<path
				d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"
				stroke-linejoin="round"
			/>
		</svg>
		<div class="text-sm leading-relaxed text-body">
			<p class="font-medium text-ink">Educational estimate only — not a diagnosis.</p>
			<p class="mt-1">
				This calculator provides an educational estimate of kidney function based on published
				formulas. It is not a medical diagnosis and should not replace advice from a qualified
				healthcare provider. eGFR is only one data point among several — including albuminuria
				(protein in urine), blood pressure, and trends over time — that inform a full assessment
				of kidney health. Always discuss your results with a doctor or nephrologist before making
				any health decisions.
			</p>
		</div>
	</div>
</section>
