---
/** Biological sex radios, read with readChoice('sex'). */
---

<fieldset>
	<legend class="block text-sm font-medium text-ink">Biological sex</legend>
	<div class="mt-1.5 flex gap-4 py-2 text-sm text-ink">
		<label class="flex items-center gap-2"><input type="radio" name="sex" value="female" checked /> Female</label>
		<label class="flex items-center gap-2"><input type="radio" name="sex" value="male" /> Male</label>
	</div>
	<p class="mt-1 text-xs text-faint">Required by the formula; refers to biological sex, not gender identity.</p>
</fieldset>
