---
const year = new Date().getFullYear();
---

<footer class="border-t border-hairline bg-canvas">
	<div class="container-page grid gap-8 py-12 sm:grid-cols-2 md:grid-cols-5">
		<div class="md:col-span-2">
			<p class="text-[15px] font-semibold text-ink">GFR Calculator</p>
			<p class="mt-2 max-w-sm text-sm leading-relaxed text-body">
				Free, open eGFR estimator built to be verifiably accurate — every formula shows its full
				step-by-step math so you and your clinician can check the result yourselves.
			</p>
		</div>

		<div>
			<p class="text-xs font-medium uppercase tracking-wide text-mute font-mono">Tools</p>
			<ul class="mt-3 space-y-2 text-sm">
				<li><a href="/" class="text-body hover:text-ink">GFR Calculator</a></li>
				<li><a href="/methodology" class="text-body hover:text-ink">Methodology</a></li>
			</ul>
		</div>

		<div>
			<p class="text-xs font-medium uppercase tracking-wide text-mute font-mono">Resources</p>
			<ul class="mt-3 space-y-2 text-sm">
				<li>
					<a
						href="https://www.kidney.org/professionals/ckd-epi-creatinine-equation-2021"
						target="_blank"
						rel="noopener noreferrer"
						class="text-body hover:text-ink"
					>
						NKF CKD-EPI 2021 reference
					</a>
				</li>
				<li>
					<a
						href="https://pmc.ncbi.nlm.nih.gov/articles/PMC7481157/"
						target="_blank"
						rel="noopener noreferrer"
						class="text-body hover:text-ink"
					>
						Seiberth et al. 2020 study
					</a>
				</li>
			</ul>
		</div>

		<div>
			<p class="text-xs font-medium uppercase tracking-wide text-mute font-mono">Company</p>
			<ul class="mt-3 space-y-2 text-sm">
				<li><a href="/about" class="text-body hover:text-ink">About Us</a></li>
				<li><a href="/contact" class="text-body hover:text-ink">Contact Us</a></li>
				<li><a href="/privacy-policy" class="text-body hover:text-ink">Privacy Policy</a></li>
				<li><a href="/terms" class="text-body hover:text-ink">Terms &amp; Conditions</a></li>
			</ul>
		</div>
	</div>

	<div class="container-page border-t border-hairline py-6">
		<p class="text-xs leading-relaxed text-faint">
			&copy; {year} GFR Calculator. For educational purposes only — not a substitute for professional
			medical advice, diagnosis, or treatment. See our <a href="/methodology" class="underline hover:text-body">methodology</a> for formula sources,
			our <a href="/privacy-policy" class="underline hover:text-body">privacy policy</a>, and our
			<a href="/terms" class="underline hover:text-body">terms &amp; conditions</a>.
		</p>
	</div>
</footer>
