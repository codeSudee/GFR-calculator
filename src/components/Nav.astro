---
const navLinks = [
	{ href: '/', label: 'Calculator' },
	{ href: '/methodology', label: 'Methodology' },
];

const currentPath = new URL(Astro.request.url).pathname;
---

<header class="border-b border-hairline bg-canvas">
	<div class="container-page flex h-14 items-center justify-between gap-2">
		<a href="/" class="flex shrink-0 items-center gap-2 text-[15px] font-semibold tracking-tight text-ink" aria-label="GFR Calculator home">
			<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="shrink-0">
				<path
					d="M12 2C12 2 5 10.5 5 15a7 7 0 0 0 14 0c0-4.5-7-13-7-13Z"
					fill="var(--color-ink)"
				/>
				<path d="M12 6.5C12 6.5 8.5 11 8.5 14.2a3.5 3.5 0 0 0 7 0c0-3.2-3.5-7.7-3.5-7.7Z" fill="var(--color-canvas)" />
			</svg>
			<span class="hidden sm:inline">GFR Calculator</span>
			<span class="sm:hidden">GFR Calc</span>
		</a>

		<div class="flex items-center gap-1">
			<nav aria-label="Primary">
				<ul class="flex items-center gap-0.5 sm:gap-1">
					{
						navLinks.map((link) => {
							const isActive = currentPath === link.href;
							return (
								<li>
									<a
										href={link.href}
										aria-current={isActive ? 'page' : undefined}
										class:list={[
											'rounded-full px-2.5 py-1.5 text-sm transition-colors sm:px-3',
											isActive ? 'text-ink font-medium' : 'text-body hover:text-ink',
										]}
									>
										{link.label}
									</a>
								</li>
							);
						})
					}
				</ul>
			</nav>

			<button
				type="button"
				id="theme-toggle"
				aria-label="Toggle dark mode"
				aria-pressed="false"
				class="ml-1 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-body transition-colors hover:text-ink hover:bg-hairline-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link"
			>
				<svg id="theme-toggle-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="hidden">
					<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" />
					<path d="M12 2v2.5M12 19.5V22M4.22 4.22l1.77 1.77M18 18l1.78 1.78M2 12h2.5M19.5 12H22M4.22 19.78 6 18M18 6l1.78-1.78" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
				</svg>
				<svg id="theme-toggle-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" />
				</svg>
			</button>
		</div>
	</div>
</header>

<script is:inline>
	(function () {
		var toggle = document.getElementById('theme-toggle');
		var sunIcon = document.getElementById('theme-toggle-sun');
		var moonIcon = document.getElementById('theme-toggle-moon');

		function syncIcons() {
			var isDark = document.documentElement.classList.contains('dark');
			if (toggle) toggle.setAttribute('aria-pressed', String(isDark));
			if (sunIcon) sunIcon.classList.toggle('hidden', !isDark);
			if (moonIcon) moonIcon.classList.toggle('hidden', isDark);
		}

		syncIcons();

		toggle?.addEventListener('click', function () {
			var isDark = document.documentElement.classList.toggle('dark');
			try {
				localStorage.setItem('theme', isDark ? 'dark' : 'light');
			} catch (e) {}
			syncIcons();
		});
	})();
</script>
