---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
	/** Page-specific JSON-LD nodes, merged into the sitewide @graph. */
	schema?: Record<string, unknown>[];
	/** Breadcrumb trail after Home, e.g. [{ name: 'CKD Stages', href: '/ckd-stages' }]. */
	breadcrumbs?: { name: string; href: string }[];
	/** ISO date (YYYY-MM-DD) of the last substantive content update. */
	modified?: string;
}

const {
	title = 'GFR Calculator — Free Online eGFR & Kidney Function Calculator',
	description = 'Free GFR calculator with weight, creatinine, and age — computes eGFR using CKD-EPI, MDRD, and Cockcroft-Gault formulas. Includes a pediatric GFR calculator, full unit conversion, and step-by-step math for every result.',
	image = '/og-image.png',
	noindex = false,
	schema = [],
	breadcrumbs = [],
	modified,
} = Astro.props;

// Static output is emitted as page.html, so strip the extension (and index) to get the public URL.
const canonicalPath = Astro.url.pathname.replace(/(?:index)?\.html$/, '').replace(/(.)\/$/, '$1') || '/';
const canonicalURL = new URL(canonicalPath, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const origin = 'https://gfrcalc.com';

const breadcrumbNode = breadcrumbs.length
	? {
			'@type': 'BreadcrumbList',
			'@id': `${canonicalURL.href}#breadcrumb`,
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
				...breadcrumbs.map((crumb, i) => ({
					'@type': 'ListItem',
					position: i + 2,
					name: crumb.name,
					item: `${origin}${crumb.href}`,
				})),
			],
		}
	: null;

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': `${origin}/#organization`,
			name: 'GFR Calculator',
			url: `${origin}/`,
			logo: { '@type': 'ImageObject', url: `${origin}/web-app-manifest-512x512.png`, width: 512, height: 512 },
		},
		{
			'@type': 'WebSite',
			'@id': `${origin}/#website`,
			url: `${origin}/`,
			name: 'GFR Calculator',
			inLanguage: 'en',
			publisher: { '@id': `${origin}/#organization` },
		},
		{
			'@type': 'WebPage',
			'@id': `${canonicalURL.href}#webpage`,
			url: canonicalURL.href,
			name: title,
			description,
			inLanguage: 'en',
			isPartOf: { '@id': `${origin}/#website` },
			publisher: { '@id': `${origin}/#organization` },
			primaryImageOfPage: { '@type': 'ImageObject', url: ogImageURL.href },
			...(modified ? { dateModified: modified } : {}),
			...(breadcrumbNode ? { breadcrumb: { '@id': breadcrumbNode['@id'] } } : {}),
		},
		...(breadcrumbNode ? [breadcrumbNode] : []),
		...schema,
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			// Runs before paint to avoid a flash of the wrong theme.
			// Priority: saved preference > OS preference. Safe no-op if storage is blocked.
			(function () {
				try {
					var stored = localStorage.getItem('theme');
					var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
					var isDark = stored === 'dark' || (stored !== 'light' && prefersDark);
					document.documentElement.classList.toggle('dark', isDark);
				} catch (e) {}
			})();
		</script>
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="GFR" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
		<meta name="author" content="GFR Calculator" />
		<meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="GFR Calculator" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="GFR Calculator — free online eGFR and kidney function calculator" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content="GFR Calculator — free online eGFR and kidney function calculator" />

		<title>{title}</title>

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
		<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

		<!-- Google AdSense -->
		<script
			async
			src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6778789012514648"
			crossorigin="anonymous"></script>

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-C9908PTPB6"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-C9908PTPB6');
		</script>

		<slot name="head" />
	</head>
	<body class="bg-canvas text-ink antialiased">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:bg-ink focus:px-3 focus:py-2 focus:text-sm focus:text-canvas"
		>
			Skip to content
		</a>
		<Nav />
		<main id="main-content">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	html {
		scroll-behavior: smooth;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}
</style>
